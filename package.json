{
  "name": "squarespace-blog",
  "version": "1.0.0",
  "private": true,
  "description": "Squarespace blog overlay plugin with custom layouts",
  "workspaces": [
    "client",
    "server",
    "renderer"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=client & npm run dev --workspace=server",
    "dev:vercel": "vercel dev",
    "build:scripts": "node scripts/build.mjs",
    "build": "npm run build:scripts && npm run build --workspace=server && npm run build --workspace=client",
    "lint": "npm run lint --workspaces --if-present",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@vercel/queue": "^0.2.0",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@vercel/node": "^5.1.14",
    "terser": "^5.39.0"
  }
}
