// Prisma schema for Squarespace Blog Overlay

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int      @id @default(autoincrement())
  email            String   @unique
  name             String?  // from checkout metadata
  stripeCustomerId String?  @unique @map("stripe_customer_id")
  createdAt        DateTime @default(now()) @map("created_at")

  configs          Config[]
  subscriptions   Subscription[]
  loginTokens     LoginToken[]
  sessions        Session[]
  sites           Site[]
  checkoutSessions CheckoutSession[]
  supportConversations SupportConversation[]
  supportTickets       SupportTicket[]

  @@map("users")
}

model Config {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  configJson String  @map("config_json")
  updatedAt DateTime @default(now()) @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("configs")
}

model Site {
  id                  String   @id @default(uuid())
  userId              Int      @map("user_id")
  siteKey             String   @unique @map("site_key")
  name                String?
  url                 String?
  blogPath            String?  @map("blog_path") // e.g. /blog, /journal - path where blog lives
  blogPassword        String?  @map("blog_password") @db.Text // AES-256-GCM ciphertext (enc:v1:); Squarespace blog password
  squarespaceApiKeyEnc String? @map("squarespace_api_key_enc") @db.Text // encrypted Squarespace Profiles API key
  squarespaceApiKeyInvalidAt DateTime? @map("squarespace_api_key_invalid_at")
  squarespaceApiKeyAlertEmailSentAt DateTime? @map("squarespace_api_key_alert_email_sent_at")
  status              String   @default("active") // active | disabled
  verificationStatus  String   @default("pending") @map("verification_status") // pending | verified | needs_attention
  paywallMode         String   @default("auto") @map("paywall_mode") // auto | force_logged_out | force_logged_in
  paywallDetectionState String @default("unknown") @map("paywall_detection_state") // unknown | detected_paywalled | detected_unpaywalled
  paywallDetectionSource String? @map("paywall_detection_source") // json_probe | manual
  channel             String   @default("stable") // stable | beta
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteConfigs            SiteConfig[]
  blogAuthors           BlogAuthor[]
  analyticsEvents       AnalyticsEvent[]
  googleAnalytics       SiteGoogleAnalytics?
  fathomAnalytics       SiteFathomAnalytics?
  leadCaptures          LeadCapture[]
  blogCommentSettings   BlogCommentSettings?
  emailIntegrations     SiteEmailIntegration[]
  emailCredentials      SiteEmailCredential[]
  sitePaywallSettings   SitePaywallSettings?
  cachedPosts           CachedPost[]
  comments              Comment[]
  commentVerificationTokens CommentVerificationToken[]
  commenterOtpChallenges CommenterOtpChallenge[]
  commenterSessions     CommenterSession[]
  supportConversations  SupportConversation[]
  supportTickets        SupportTicket[]
  previewSnapshots      PreviewSnapshot[]

  @@index([siteKey])
  @@index([userId])
  @@index([userId, deletedAt])
  @@index([userId, url, deletedAt])
  @@map("sites")
}

model SiteGoogleAnalytics {
  id              String   @id @default(uuid())
  siteId          String   @unique @map("site_id")
  measurementId   String   @map("measurement_id") // G-XXXXXXXXXX, prompted per-site
  metricsEnabled  String[] @map("metrics_enabled") // traffic_sources | top_referrers | new_vs_returning
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @map("updated_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@map("site_google_analytics")
}

model SiteFathomAnalytics {
  id             String   @id @default(uuid())
  siteId         String   @unique @map("site_id")
  fathomSiteId   String   @map("fathom_site_id") // public Site ID from Fathom Settings → Sites
  metricsEnabled String[] @map("metrics_enabled") // traffic_sources | top_referrers | new_vs_returning
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @map("updated_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@map("site_fathom_analytics")
}

model AnalyticsEvent {
  id         String   @id @default(uuid())
  siteId     String   @map("site_id")
  eventType  String   @map("event_type") // page_view | scroll_depth | click | search | search_click | time_on_page
  occurredAt DateTime @default(now()) @map("occurred_at")

  visitorId  String?  @map("visitor_id")
  postId     String?  @map("post_id")
  postIndex  Int?     @map("post_index")
  url        String?

  payload    Json?

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, eventType, occurredAt])
  @@index([siteId, postId, occurredAt])
  @@index([siteId, visitorId, occurredAt])
  @@map("analytics_events")
}

enum IngestedFrom {
  SQUARESPACE
  BETTER_BLOG
}

enum BioFormat {
  text
  markdown
  html
}

model BlogAuthor {
  id           String       @id @default(uuid())
  siteId       String       @map("site_id")
  name         String
  imageUrl     String?      @map("image_url") @db.Text
  bio          String?      @db.Text
  bioLong      String?      @map("bio_long") @db.Text
  bioFormat    BioFormat    @default(text) @map("bio_format")
  email        String?
  socialLinks  Json?        @map("social_links")
  ingestedFrom IngestedFrom @default(BETTER_BLOG) @map("ingested_from")
  isDefault    Boolean      @default(false) @map("is_default")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @default(now()) @map("updated_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, name])
  @@index([siteId])
  @@map("blog_authors")
}

model SiteConfig {
  id                   String   @id @default(uuid())
  siteId               String   @map("site_id")
  version              Int
  showDate             Boolean  @default(true) @map("show_date")
  showAuthor           Boolean  @default(false) @map("show_author")
  showReadingTime      Boolean  @default(false) @map("show_reading_time")
  authorSettings       Json     @default("{\"defaultAuthorIds\":[],\"postAuthorOverrides\":{}}") @map("author_settings")
  progressBar          Json     @default("{\"show\":false,\"position\":null}") @map("progress_bar")
  tableOfContents      Json     @default("{\"show\":false,\"position\":null}") @map("table_of_contents")
  recentPostsSidebar   Json     @default("{\"show\":false,\"position\":null}") @map("recent_posts_sidebar")
  leftSidebar          Json?    @map("left_sidebar")
  rightSidebar         Json?    @map("right_sidebar")
  headerContent        Json?    @map("header_content")
  socialMediaLinks     Json?    @map("social_media_links")
  featuredImage        Json?    @map("featured_image")
  collectionConfig     Json?    @map("collection_config")
  postConfig           Json?    @map("post_config")
  collectionTemplateId String?  @map("collection_template_id")
  postTemplateId       String?  @map("post_template_id")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@map("site_configs")
}

model TemplateConfig {
  id               String   @id @default(uuid())
  templateKey      String   @map("template_key")
  level            String
  name             String
  description      String?  @db.Text
  collectionConfig Json?    @map("collection_config")
  postConfig       Json?    @map("post_config")
  previewLayout    String   @map("preview_layout")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([templateKey, level])
  @@map("template_configs")
}

model Subscription {
  id                    String    @id @default(uuid())
  userId                Int       @map("user_id")
  stripeCustomerId      String    @unique @map("stripe_customer_id")
  stripeSubscriptionId   String?   @unique @map("stripe_subscription_id")
  stripePriceId         String?   @map("stripe_price_id")
  plan                  String    // essentials | professional | publication | studio
  status                String    // trialing | active | past_due | canceled
  source                String    @default("stripe") // stripe | beta
  maxSites              Int?      @map("max_sites") // total blogs; null = unlimited (grandfathered or beta)
  maxWebsites           Int?      @map("max_websites") // distinct hostnames; null = unlimited
  maxBlogsPerWebsite    Int?      @map("max_blogs_per_website") // null = unlimited
  currentPeriodEnd      DateTime? @map("current_period_end")
  cancelAtPeriodEnd     Boolean   @default(false) @map("cancel_at_period_end")
  paymentFailedAt       DateTime? @map("payment_failed_at") // start of the 7-day past_due grace window
  trialDayFourEmailSentAt DateTime? @map("trial_day_four_email_sent_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("subscriptions")
}

model CheckoutSession {
  id                      String    @id @default(uuid())
  stripeCheckoutSessionId String    @unique @map("stripe_checkout_session_id")
  userId                  Int?      @map("user_id")
  email                   String?
  plan                    String    // essentials | professional | publication | studio
  stripePriceId           String    @map("stripe_price_id")
  status                  String    // created | completed | expired | canceled
  createdAt               DateTime  @default(now()) @map("created_at")
  completedAt             DateTime? @map("completed_at")
  metadataJson            String?   @map("metadata_json")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([stripeCheckoutSessionId])
  @@map("checkout_sessions")
}

model Plan {
  planKey           String   @map("plan_key") // essentials | professional | publication | studio
  cadence           String   // monthly | annual
  stripePriceId     String   @map("stripe_price_id")
  stripePriceLabel  String   @map("stripe_price_label") // e.g. better_blog_essentials_monthly_usd
  maxSites          Int?     @map("max_sites") // total blogs
  maxWebsites       Int?     @map("max_websites")
  maxBlogsPerWebsite Int?    @map("max_blogs_per_website")
  stripeEnvironment String   @map("stripe_environment") // sandbox | live

  @@id([planKey, cadence, stripeEnvironment])
  @@map("plans")
}

model StripeWebhookEvent {
  id             String    @id @default(uuid())
  stripeEventId  String    @unique @map("stripe_event_id")
  type           String
  receivedAt     DateTime  @default(now()) @map("received_at")
  processedAt    DateTime? @map("processed_at")
  status         String    @default("pending") // pending | processed | failed
  error          String?

  @@index([stripeEventId])
  @@map("stripe_webhook_events")
}

model LoginToken {
  id        String    @id @default(uuid())
  userId    Int       @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  purpose   String    // login | invite

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("login_tokens")
}

model Session {
  id               String    @id @default(uuid())
  userId           Int       @map("user_id")
  sessionTokenHash String    @map("session_token_hash")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionTokenHash])
  @@map("sessions")
}

model CustomerLead {
  id        Int      @id @default(autoincrement())
  email     String
  name      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([email])
  @@map("customer_leads")
}

model LeadCapture {
  id            String   @id @default(uuid())
  siteId        String   @map("site_id")
  email         String
  name          String?
  type          String   // newsletter | lead_magnet
  resourceTitle String?  @map("resource_title") // for lead_magnet: which resource; empty for newsletter
  createdAt     DateTime @default(now()) @map("created_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, email, type, resourceTitle])
  @@index([siteId, type])
  @@index([siteId, createdAt])
  @@map("lead_captures")
}

model PreviewSnapshot {
  id         String   @id @default(uuid())
  siteId     String   @map("site_id")
  pageKind   String   @map("page_kind") // collection | post
  sourcePath String   @map("source_path")
  html       String   @db.Text
  quality    String // http | http-sparse | browser
  byteSize   Int      @map("byte_size")
  fetchedAt  DateTime @default(now()) @map("fetched_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, pageKind, sourcePath])
  @@index([siteId, fetchedAt])
  @@map("preview_snapshots")
}

model CachedPost {
  siteId        String   @map("site_id")
  externalPostId String  @map("external_post_id") // Squarespace post ID or fullUrl
  title         String   @db.Text
  publishedAt   DateTime @map("published_at")
  url           String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([siteId, externalPostId])
  @@map("cached_posts")
}

model Comment {
  id                       String    @id @default(uuid())
  siteId                   String    @map("site_id")
  postId                   String    @map("post_id") // Squarespace post ID or fullUrl
  parentId                 String?   @map("parent_id")
  displayName              String    @map("display_name")
  email                    String?   @db.Text
  verifiedSubscriber       Boolean   @default(false) @map("verified_subscriber")
  squarespaceProfileId     String?   @map("squarespace_profile_id") @db.Text
  body                     String    @db.Text
  status                   String    @default("pending") // pending | approved | spam | hidden | deleted
  autoApproved             Boolean   @default(false) @map("auto_approved")
  ipAddress                String?   @map("ip_address") @db.VarChar(45)
  userAgent                String?   @map("user_agent") @db.Text
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @default(now()) @map("updated_at")
  /// Squarespace native comment id when row was lazy-imported from GetComments (enables replies)
  externalCommentId        String?   @map("external_comment_id")
  importedFromSquarespace  Boolean   @default(false) @map("imported_from_squarespace")
  commenterSessionId       String?   @map("commenter_session_id")
  clientReportedLoggedIn   Boolean?  @map("client_reported_logged_in")

  site         Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  commenterSession CommenterSession? @relation(fields: [commenterSessionId], references: [id], onDelete: SetNull)
  parent       Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies      Comment[]     @relation("CommentReplies")
  commentLikes CommentLike[]

  @@unique([siteId, postId, externalCommentId], name: "comments_site_post_external_id")
  @@index([siteId])
  @@index([postId])
  @@index([status])
  @@index([createdAt])
  @@map("comments")
}

/// Opaque member-comment session. The browser stores the token, not the email.
model CommentVerificationToken {
  token       String   @id
  siteId      String   @map("site_id")
  email       String   @db.Text
  displayName String   @map("display_name")
  customName  Boolean  @default(false) @map("custom_name")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@index([expiresAt])
  @@map("comment_verification_tokens")
}

/// One-time code for proving a commenter owns an email. The plain code is never stored.
model CommenterOtpChallenge {
  id          String    @id @default(uuid())
  siteId      String    @map("site_id")
  hostname    String
  email       String
  displayName String    @map("display_name")
  codeHash    String    @map("code_hash")
  attempts    Int       @default(0)
  expiresAt   DateTime  @map("expires_at")
  consumedAt  DateTime? @map("consumed_at")
  ip          String?
  userAgent   String?   @map("user_agent")
  createdAt   DateTime  @default(now()) @map("created_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([hostname, email, createdAt])
  @@index([ip, createdAt])
  @@map("commenter_otp_challenges")
}

/// Opaque commenter session. The browser stores the token; the database stores its hash.
model CommenterSession {
  id             String    @id @default(uuid())
  siteId         String?   @map("site_id")
  hostname       String
  email          String
  displayName    String    @map("display_name")
  tokenHash      String    @unique @map("token_hash")
  createdAt      DateTime  @default(now()) @map("created_at")
  lastExtendedAt DateTime  @default(now()) @map("last_extended_at")
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  ip             String?
  userAgent      String?   @map("user_agent")

  site     Site?     @relation(fields: [siteId], references: [id], onDelete: SetNull)
  comments Comment[]

  @@index([hostname, email])
  @@map("commenter_sessions")
}

/// Failed OTP verify attempts, counted by IP. Kept separate from the challenge's start IP.
model CommenterAuthEvent {
  id        String   @id @default(uuid())
  ip        String
  kind      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ip, kind, createdAt])
  @@map("commenter_auth_events")
}

model CommentLike {
  commentId   String   @map("comment_id")
  fingerprint String   @map("fingerprint")
  createdAt   DateTime @default(now()) @map("created_at")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([commentId, fingerprint])
  @@map("comment_likes")
}

model BlogCommentSettings {
  siteId                   String   @id @map("site_id")
  commentsEnabled          Boolean  @default(true) @map("comments_enabled")
  allowNewComments         Boolean  @default(true) @map("allow_new_comments")
  allowAnonymousComments   Boolean  @default(true) @map("allow_anonymous_comments")
  subscriberCommentsEnabled Boolean @default(false) @map("subscriber_comments_enabled")
  requireApproval          Boolean  @default(false) @map("require_approval")
  autoCloseAfterDays       Int?     @map("auto_close_after_days")
  notifyEmail              Boolean  @default(true) @map("notify_email")
  notificationEmail       String?  @map("notification_email") @db.Text
  allowLikes               Boolean  @default(true) @map("allow_likes")
  allowThreadedReplies     Boolean  @default(true) @map("allow_threaded_replies")
  sortOrder                String   @default("newest") @map("sort_order") // newest | oldest | most_liked
  updatedAt                DateTime @default(now()) @map("updated_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@map("blog_comment_settings")
}

model SiteEmailIntegration {
  siteId          String    @map("site_id")
  module          String    @default("collection_newsletter") // collection_newsletter | post_newsletter | collection_lead_magnet | post_lead_magnet
  provider        String    @default("betterblog") // betterblog | kit | mailchimp
  apiKeyEnc       String?   @map("api_key_enc") @db.Text
  destinationId   String?   @map("destination_id") // Kit form/tag id or Mailchimp audience id
  destinationKind String?   @map("destination_kind") // kit: form | tag
  tagId           String?   @map("tag_id") // Mailchimp tag (static segment) id
  tagName         String?   @map("tag_name") // Mailchimp tag name, applied on subscribe
  lastError       String?   @map("last_error") @db.Text
  lastErrorAt     DateTime? @map("last_error_at")
  lastSuccessAt   DateTime? @map("last_success_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([siteId, module])
  @@map("site_email_integrations")
}

model SiteEmailCredential {
  siteId    String   @map("site_id")
  provider  String // kit | mailchimp
  apiKeyEnc String   @map("api_key_enc") @db.Text
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([siteId, provider])
  @@map("site_email_credentials")
}

model SitePaywallSettings {
  siteId             String   @id @map("site_id")
  subscribeUrl       String?  @map("subscribe_url") @db.Text
  footerDescription  String?  @map("footer_description") @db.VarChar(160)
  eyebrowText        String?  @map("eyebrow_text") @db.VarChar(80)
  headlineText       String?  @map("headline_text") @db.VarChar(160)
  featureItems       String[] @default([]) @map("feature_items")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@map("site_paywall_settings")
}

model SupportConversation {
  id          String    @id @default(uuid())
  userId      Int       @map("user_id")
  siteId      String?   @map("site_id")
  messages    Json
  escalated   Boolean   @default(false)
  escalatedAt DateTime? @map("escalated_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  site    Site?           @relation(fields: [siteId], references: [id], onDelete: SetNull)
  tickets SupportTicket[]

  @@index([userId])
  @@index([createdAt])
  @@index([escalated])
  @@map("support_conversations")
}

model SupportTicket {
  id             String   @id @default(uuid())
  userId         Int      @map("user_id")
  siteId         String?  @map("site_id")
  subject        String
  description    String   @db.Text
  screenshotUrl  String?  @map("screenshot_url") @db.Text
  conversationId String?  @map("conversation_id")
  accountEmail   String   @map("account_email")
  blogUrl        String?  @map("blog_url") @db.Text
  status         String   @default("open")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  site         Site?                @relation(fields: [siteId], references: [id], onDelete: SetNull)
  conversation SupportConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("support_tickets")
}
