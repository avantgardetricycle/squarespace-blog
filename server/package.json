{
  "name": "server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:fresh": "lsof -ti :3001 | xargs kill -9 2>/dev/null; tsx watch src/index.ts",
    "build": "prisma generate && tsc && cp -r src/generated dist/ && npm run generate-email-logo && cp src/emails/logo-email.png dist/emails/",
    "start": "node dist/index.js",
    "db:push": "prisma db push --accept-data-loss",
    "db:check": "tsx scripts/check-db-connection.ts",
    "db:seed-plans": "tsx scripts/seed-plans.ts",
    "db:seed": "prisma db seed",
    "db:seed:staging": "prisma db seed -- --target=staging",
    "db:seed:production": "prisma db seed -- --target=production",
    "db:studio": "prisma studio",
    "generate-email-logo": "tsx scripts/generate-email-logo.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "@react-email/components": "^0.0.35",
    "@react-email/render": "^2.0.4",
    "@sendgrid/mail": "^8.1.6",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "nodemailer": "^8.0.1",
    "pg": "^8.18.0",
    "@vercel/queue": "^0.2.0",
    "prisma": "^7.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.34.5",
    "stripe": "^20.3.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.16.0",
    "dotenv": "^16.6.1",
    "typescript": "~5.6.2"
  }
}