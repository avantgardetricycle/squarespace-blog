# --- Database (Supabase recommended) ---
# Runtime (Vercel / serverless): Supabase transaction pooler, port 6543
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
#
# Migrations / Prisma CLI: direct connection, port 5432 (session mode)
# DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
#
# Local Postgres: use the same URL for both, or omit DIRECT_URL (falls back to DATABASE_URL)
DATABASE_URL=
DIRECT_URL=

# Local dev only: relax TLS verification for Supabase (db:check, prisma db push)
# SUPABASE_SSL_NO_VERIFY=true

# Seed target for `npm run db:seed` when no --target flag is provided.
# Use staging for local/preview DBs; production skips demo fixtures and seeds live Stripe plans.
# SEED_TARGET=staging

# App URL (CORS, magic links, checkout redirects)
APP_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=
# Must match plans.stripe_environment in DB: sandbox (test key) or live (live key).
# Aliases also accepted: test/staging → sandbox; production/prod → live.
STRIPE_ENVIRONMENT=sandbox
STRIPE_WEBHOOK_SECRET=

# Stripe queue: set true to process webhooks inline without Vercel Queues (default in local dev)
# STRIPE_QUEUE_INLINE_FALLBACK=true

# Google Analytics (server-side event forwarding)
GA_API_SECRET=

# SendGrid
SENDGRID_API_KEY=
SENDGRID_MAIL_FROM=BetterBlog <no-reply@betterblog.xyz>

# Comments
ENCRYPTION_KEY=
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=

# Landing page CTA
# IS_BETTER_BLOG_LIVE=true
