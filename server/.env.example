# PostgreSQL connection string
# Heroku provides DATABASE_URL automatically when you add Heroku Postgres
# Local example: postgresql://user:password@localhost:5432/squarespace_blog
DATABASE_URL=

# App URL (used for redirects, magic links, checkout, etc.)
APP_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=
STRIPE_ENVIRONMENT=sandbox
# Webhook signing secret (from Stripe Dashboard > Webhooks > Add endpoint > Signing secret)
STRIPE_WEBHOOK_SECRET=

# SendGrid (for post-checkout invite emails)
SENDGRID_API_KEY=
# Sender address (must be verified in SendGrid)
SENDGRID_MAIL_FROM=BetterBlog <no-reply@revsplit.app>
