# PostgreSQL connection string
# Heroku provides DATABASE_URL automatically when you add Heroku Postgres
# Local example: postgresql://user:password@localhost:5432/squarespace_blog
DATABASE_URL=

# App URL (used for redirects, magic links, checkout, etc.)
APP_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=
STRIPE_ENVIRONMENT=sandbox
# Webhook signing secret (from Stripe Dashboard > Webhooks > Add endpoint > Signing secret)
STRIPE_WEBHOOK_SECRET=

# Google Analytics (for server-side event forwarding)
# GA4 Admin → Data Streams → Measurement Protocol API secrets
# Measurement ID is prompted per-site in the UI
GA_API_SECRET=

# SendGrid (for post-checkout invite emails, comment notifications)
SENDGRID_API_KEY=
# Sender address (must be verified in SendGrid)
SENDGRID_MAIL_FROM=BetterBlog <no-reply@betterblog.xyz>

# Comments
# AES-256 key for encrypting Squarespace API keys (32-byte hex = 64 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# hCaptcha (sign up at hcaptcha.com)
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=
# Secret for signing comment action links in emails (optional; falls back to ENCRYPTION_KEY)
# COMMENT_ACTION_SECRET=
