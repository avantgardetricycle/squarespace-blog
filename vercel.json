{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build --workspace=server && npm run build --workspace=client",
  "installCommand": "npm install --include=dev",
  "framework": null,
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/loader.js",
      "destination": "/api"
    },
    {
      "source": "/renderer.js",
      "destination": "/api"
    },
    {
      "source": "/api/webhooks/stripe",
      "destination": "/api/webhooks/stripe"
    },
    {
      "source": "/api/queues/stripe-checkout-session-completed",
      "destination": "/api/queues/stripe-checkout-session-completed"
    },
    {
      "source": "/api/queues/stripe-customer-subscription-updated",
      "destination": "/api/queues/stripe-customer-subscription-updated"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/health.ts": {
      "maxDuration": 10
    },
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "{scripts/**,server/dist/**,client/dist/**}"
    },
    "api/webhooks/stripe.ts": {
      "maxDuration": 30,
      "includeFiles": "server/dist/**"
    },
    "api/queues/stripe-checkout-session-completed.ts": {
      "maxDuration": 60,
      "includeFiles": "server/dist/**",
      "experimentalTriggers": [
        {
          "type": "queue/v1beta",
          "topic": "stripe.checkout.session.completed",
          "consumer": "default"
        }
      ]
    },
    "api/queues/stripe-customer-subscription-updated.ts": {
      "maxDuration": 60,
      "includeFiles": "server/dist/**",
      "experimentalTriggers": [
        {
          "type": "queue/v1beta",
          "topic": "stripe.customer.subscription.updated",
          "consumer": "default"
        }
      ]
    }
  }
}
