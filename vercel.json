{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build:scripts && npm run build --workspace=server && npm run build --workspace=client",
  "installCommand": "npm install --include=dev",
  "framework": null,
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/geo",
      "destination": "/api/geo"
    },
    {
      "source": "/api/cron/ping-squarespace-api-keys",
      "destination": "/api/cron/ping-squarespace-api-keys"
    },
    {
      "source": "/api/cron/refresh-preview-snapshots",
      "destination": "/api/cron/refresh-preview-snapshots"
    },
    {
      "source": "/api/cron/trial-day-four-reminder",
      "destination": "/api/cron/trial-day-four-reminder"
    },
    {
      "source": "/api/webhooks/stripe",
      "destination": "/api/webhooks/stripe"
    },
    {
      "source": "/api/queues/stripe-checkout-session-completed",
      "destination": "/api/queues/stripe-checkout-session-completed"
    },
    {
      "source": "/api/queues/stripe-customer-subscription-updated",
      "destination": "/api/queues/stripe-customer-subscription-updated"
    },
    {
      "source": "/api/queues/stripe-customer-subscription-deleted",
      "destination": "/api/queues/stripe-customer-subscription-deleted"
    },
    {
      "source": "/api/queues/stripe-invoice-paid",
      "destination": "/api/queues/stripe-invoice-paid"
    },
    {
      "source": "/api/queues/stripe-invoice-payment-failed",
      "destination": "/api/queues/stripe-invoice-payment-failed"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/health.ts": {
      "maxDuration": 10
    },
    "api/geo.ts": {
      "maxDuration": 10
    },
    "api/cron/ping-squarespace-api-keys.ts": {
      "maxDuration": 60,
      "includeFiles": "server/dist/**"
    },
    "api/cron/refresh-preview-snapshots.ts": {
      "maxDuration": 60,
      "includeFiles": "server/dist/**"
    },
    "api/cron/trial-day-four-reminder.ts": {
      "maxDuration": 60,
      "includeFiles": "server/dist/**"
    },
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "{scripts/**,server/dist/**,client/dist/**}"
    },
    "api/webhooks/stripe.ts": {
      "maxDuration": 30,
      "includeFiles": "server/dist/**"
    },
    "api/queues/stripe-checkout-session-completed.ts": {
      "maxDuration": 60,
      "includeFiles": "server/dist/**",
      "experimentalTriggers": [
        {
          "type": "queue/v1beta",
          "topic": "stripe.checkout.session.completed",
          "consumer": "default"
        }
      ]
    },
    "api/queues/stripe-customer-subscription-updated.ts": {
      "maxDuration": 60,
      "includeFiles": "server/dist/**",
      "experimentalTriggers": [
        {
          "type": "queue/v1beta",
          "topic": "stripe.customer.subscription.updated",
          "consumer": "default"
        }
      ]
    },
    "api/queues/stripe-customer-subscription-deleted.ts": {
      "maxDuration": 60,
      "includeFiles": "server/dist/**",
      "experimentalTriggers": [
        {
          "type": "queue/v1beta",
          "topic": "stripe.customer.subscription.deleted",
          "consumer": "default"
        }
      ]
    },
    "api/queues/stripe-invoice-paid.ts": {
      "maxDuration": 60,
      "includeFiles": "server/dist/**",
      "experimentalTriggers": [
        {
          "type": "queue/v1beta",
          "topic": "stripe.invoice.paid",
          "consumer": "default"
        }
      ]
    },
    "api/queues/stripe-invoice-payment-failed.ts": {
      "maxDuration": 60,
      "includeFiles": "server/dist/**",
      "experimentalTriggers": [
        {
          "type": "queue/v1beta",
          "topic": "stripe.invoice.payment_failed",
          "consumer": "default"
        }
      ]
    }
  },
  "headers": [
    {
      "source": "/loader.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/renderer.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/ping-squarespace-api-keys",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/refresh-preview-snapshots",
      "schedule": "30 15 * * *"
    },
    {
      "path": "/api/cron/trial-day-four-reminder",
      "schedule": "59 23 * * *"
    }
  ]
}
